  m_Script: {fileID: 11500000, guid: 6758bd05c78fbe641899f3d785393489, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  NoteButton: {fileID: 1942695536}
  NotePanel: {fileID: 1024615602}
  TipPanel: {fileID: 2103117086}
  TipText: {fileID: 1211044039}
  pages:
  - {fileID: 1018467285}
  - {fileID: 50574864}
  - {fileID: 1782164929}
  fadeDuration: 0.3
  nextButton: {fileID: 2106195176}
  prevButton: {fileID: 1769339607}
  activeAlpha: 1
  inactiveAlpha: 0.5
  hintTexts:
  - "\u70B9\u51FB\u201CJ\u201D\u6309\u952E\u5173\u95ED\u95F9\u949F"
  - "\u83B7\u5F97\u9053\u5177\u201CEgg\u201D"
  - "\u83B7\u5F97\u714E\u9E21\u86CB"
  - "\u83B7\u5F97Cups filled with Orange Juice"
  - "\u6210\u529F\u653E\u7F6E\u65E9\u996D"
  - "\u5B69\u5B50\u88AB\u53EB\u9192\u4E86"
  - "\u4F60\u62FF\u8D77\u4E86\u96F6\u6563\u7684\u5BB6\u5EAD\u4F5C\u4E1A\u548C\u6559\u79D1\u4E66"
  - "\u96F6\u6563\u7684\u5BB6\u5EAD\u4F5C\u4E1A\u548C\u6559\u79D1\u4E66\u88AB\u4F60\u88C5\u8FDB\u4E86\u4E66\u5305\u91CC"
  - "\u5988\u5988\uFF1A\u201Cxxx, why didn't you do your homework again?\u201D"
  - "\u513F\u5B50\uFF1A\u201CI don't want to do homework!!\u201D"
  - "\u5988\u5988\uFF1A....\uFF08signs\uFF09"
  - "\u4E3B\u5367\u7684\u7A97\u6237\u88AB\u6253\u5F00\u4E86"
  - "\u6B21\u5367\u7684\u7A97\u6237\u88AB\u6253\u5F00\u4E86"
  - "\u4E66\u623F\u7684\u7A97\u6237\u88AB\u6253\u5F00\u4E86"
  - "\u4F60\u6253\u5F00\u4E86\u626B\u5730\u673A\u5668\u4EBA"
  - "\u8863\u670D\u88AB\u6536\u8D77\u6765\u4E86"
  - "\u628A\u8863\u670D\u653E\u8FDB\u4E86\u8863\u67DC\u91CC"
  - "\u606D\u559C\u4F60\u5B8C\u6210\u4E86\u4FBF\u7B7E\u4E0A\u8981\u5B8C\u6210\u7684\u4E8B\u60C5\uFF0C\u53EF\u4EE5\u51FA\u95E8\u53BB\u4E0A\u73ED\u4E86"
  - "\u606D\u559C\u4F60\u5230\u8FBE\u4E86\u7EC8\u70B9\uFF0C\u70B9\u51FBJ\u7ED3\u675F\u6E38\u620F\u5427"
  DescriptionPanel: {fileID: 851637521}
  StartPanel: {fileID: 489037578}
  IsDescription: 1
  PassPanel: {fileID: 1976958880}
  memoryTexts:
  - "\u7ECF\u8FC7\u4E00\u6574\u5929\u7684\u5DE5\u4F5C\uFF0C\u7EC8\u4E8E\u597D\u4E0D\u5BB9\u6613\u71AC\u5230\u4E0B\u73ED\u4E86"
  - "\u521A\u6324\u51FA\u5730\u94C1\uFF0C\u4E00\u62AC\u5934\uFF0C\u901A\u9053\u5C3D\u5934\u7684\u5E7F\u544A\u724C\u4EAE\u7740\u6696\u6A59\u8272\u7684\u5149\u3002
    \u2014\u2014\u201C\u5BB6\u7684\u5473\u9053\u201D\u3002 \uFF08\u773C\u524D\u5FFD\u7136\u604D\u60DA\uFF09
    \u6211\u597D\u50CF\u56DE\u5230\u4E86\u90A3\u4E2A\u6C38\u8FDC\u6CDB\u7740\u6CB9\u70DF\u7684\u9EC4\u660F\u53A8\u623F\u3002\u6211\u7684\u4E2A\u5B50\u90A3\u4E48\u5C0F\uFF0C\u53EA\u591F\u5F97\u7740\u684C\u6CBF\uFF0C\u770B\u5988\u5988\u5207\u897F\u7EA2\u67FF\u3002\u5979\u52A8\u4F5C\u5FEB\uFF0C\u6C41\u6DB2\u6E85\u5F00\uFF0C\u50CF\u665A\u971E\u67D3\u7EA2\u4E86\u5979\u7684\u624B\u6307\u3002\u6211\u5077\u5077\u4F38\u624B\u53BB\u62FF\uFF0C\u88AB\u5979\u7528\u624B\u80CC\u8F7B\u8F7B\u4E00\u62CD\uFF1A\u201C\u5C0F\u998B\u732B\u3002\u201D\u6211\u7F29\u56DE\u624B\uFF0C\u6307\u5C16\u8FD8\u7559\u7740\u4E00\u70B9\u51C9\u3002\u53EF\u4E0B\u4E00\u79D2\uFF0C\u90A3\u5757\u6700\u5927\u3001\u6700\u7EA2\u7684\uFF0C\u5C31\u88AB\u9001\u5230\u4E86\u6211\u5634\u8FB9\u3002
    \u7CD6\u5206\u548C\u9178\u5473\u5728\u820C\u5C16\u70B8\u5F00\u3002\u4E16\u754C\u7B80\u5355\u5F97\u50CF\u90A3\u5757\u897F\u7EA2\u67FF\uFF0C\u751C\u5F97\u76F4\u63A5\uFF0C\u6CA1\u6709\u6F5C\u53F0\u8BCD\u3002\u90A3\u65F6\u7684\u6211\u53EA\u6709\u4E00\u4E2A\u8EAB\u4EFD\uFF0C\u4E00\u4E2A\u540D\u5B57\uFF0C\u4E00\u5F20\u4E0D\u7528\u601D\u8003\u5C31\u80FD\u6234\u7A33\u7684\u8138\u2014\u2014\u5979\u7684\u5B69\u5B50\u3002"
  - "\u7EA2\u706F\uFF0C\u8F66\u5835\u7740\u3002\u8DEF\u8FB9\u7684\u4E2D\u5B66\u6B63\u597D\u653E\u5B66\uFF0C\u4E00\u7FA4\u7A7F\u7740\u80A5\u5927\u6821\u670D\u7684\u5B66\u751F\u8BF4\u7B11\u7740\u6D8C\u8FC7\u6591\u9A6C\u7EBF\u3002
    \u6709\u4E2A\u5973\u5B69\u76B1\u7740\u7709\uFF0C\u8FD8\u5728\u770B\u4E66\u3002
    \uFF08\u80F8\u53E3\u5FFD\u7136\u88AB\u4EC0\u4E48\u649E\u4E86\u4E00\u4E0B\uFF09
    \u90A3\u5E74\u7684\u671F\u672B\u8003\uFF0C\u6559\u5BA4\u91CC\u7684\u98CE\u6247\u4E5F\u662F\u8FD9\u6837\uFF0C\u628A\u5149\u6591\u5207\u5272\u5F97\u652F\u79BB\u7834\u788E\u3002\u540C\u684C\u6084\u6084\u7528\u80F3\u818A\u8098\u78B0\u6211\uFF0C\u4E00\u5F20\u5199\u7740\u201C\u7B2C\u4E09\u9898\u7B54\u6848\u201D\u7684\u5C0F\u7EB8\u6761\u63A8\u5230\u6211\u624B\u8FB9\u3002\u6211\u6447\u6447\u5934\uFF0C\u628A\u8BD5\u5377\u5F80\u81EA\u5DF1\u80F3\u818A\u5E95\u4E0B\u85CF\u4E86\u85CF\u3002
    \u8BB2\u53F0\u4E0A\uFF0C\u73ED\u4E3B\u4EFB\u8D5E\u8BB8\u5730\u5BF9\u6211\u70B9\u70B9\u5934\u3002
    \u5979\u4E0D\u77E5\u9053\uFF0C\u6211\u6447\u5934\u4E0D\u662F\u56E0\u4E3A\u8BDA\u5B9E\uFF0C\u53EA\u662F\u2026\u2026\u4E0D\u60F3\u8BA9\u5979\u8D85\u8FC7\u6211\u3002
    \u90A3\u5929\uFF0C\u6211\u7ED9\u81EA\u5DF1\u6234\u4E0A\u4E86\u7B2C\u4E00\u5F20\u771F\u6B63\u610F\u4E49\u4E0A\u7684\u9762\u5177\u2014\u2014\u201C\u8BDA\u5B9E\u7684\u597D\u5B66\u751F\u201D\u3002\u6211\u5B66\u4F1A\u4E86\uFF0C\u539F\u6765\u5728\u67D0\u4E9B\u6807\u51C6\u91CC\uFF0C\u5584\u610F\u7684\u4F2A\u88C5\u662F\u88AB\u5141\u8BB8\u7684\u3002"
  - "\u4FBF\u5229\u5E97\u95E8\u53E3\uFF0C\u4E00\u5BF9\u5E74\u8F7B\u60C5\u4FA3\u4E92\u76F8\u5582\u51B0\u6DC7\u6DCB\uFF0C\u7B11\u5F97\u5F88\u8F7B\uFF0C\u4F46\u773C\u775B\u5F88\u4EAE\u3002
    \u6211\u4F4E\u4E0B\u5934\uFF0C\u628A\u8033\u673A\u58F0\u97F3\u8C03\u5927\uFF0C\u5374\u597D\u50CF\u4EC0\u4E48\u90FD\u542C\u4E0D\u89C1\u4E86\u3002
    \uFF08\u5FC3\u810F\u67D0\u4E2A\u89D2\u843D\uFF0C\u7EC6\u5FAE\u5730\u62BD\u52A8\u4E86\u4E00\u4E0B\uFF09
    \u4F60\u8BF4\u6211\u5B89\u9759\uFF0C\u548C\u4F60\u5728\u4E00\u8D77\u7684\u65F6\u5019\u3002
    \u90A3\u662F\u5728\u672B\u73ED\u5730\u94C1\u4E0A\u5427\uFF0C\u8F66\u53A2\u7A7A\u8361\u8361\u7684\uFF0C\u73BB\u7483\u4E0A\u5012\u6620\u7740\u6211\u4EEC\u4F9D\u504E\u7684\u5F71\u5B50\u3002\u4F60\u7684\u80A9\u8180\u5F88\u7A33\u3002\u6211\u7B11\u7740\u9760\u8FC7\u53BB\uFF0C\u4EC0\u4E48\u4E5F\u6CA1\u8BF4\u3002
    \u53EF\u6211\u5FC3\u91CC\u5728\u7FFB\u6C5F\u5012\u6D77\u3002\u6211\u5728\u60F3\uFF0C\u521A\u624D\u90A3\u53E5\u8BDD\u4F1A\u4E0D\u4F1A\u592A\u8822\uFF0C\u8FD9\u4E2A\u7B11\u662F\u4E0D\u662F\u4E0D\u591F\u597D\u770B\uFF0C\u6211\u662F\u4E0D\u662F\u2026\u2026\u50CF\u4F60\u559C\u6B22\u7684\u90A3\u4E2A\u6837\u5B50\uFF1F
    \u90A3\u4EFD\u5B89\u9759\uFF0C\u662F\u6211\u6700\u67D4\u8F6F\u7684\u4F2A\u88C5\u3002\u90A3\u5F20\u53EB\u201C\u604B\u4EBA\u201D\u7684\u9762\u5177\uFF0C\u8584\u5F97\u50CF\u76AE\u80A4\uFF0C\u670D\u5E16\u5230\u6709\u65F6\u5019\uFF0C\u6211\u751A\u81F3\u5FD8\u4E86\u81EA\u5DF1\u6234\u7740\u5B83\u3002"
  - "\u5230\u5BB6\u524D\u6700\u540E\u4E00\u4E2A\u8DEF\u53E3\uFF0C\u7B49\u7EFF\u706F\u3002\u5BF9\u9762\u5199\u5B57\u697C\u8FD8\u96F6\u661F\u4EAE\u7740\u51E0\u5C42\u706F\uFF0C\u50CF\u5DE8\u5927\u800C\u6C89\u9ED8\u7684\u8702\u5DE2\u3002
    \u5176\u4E2D\u4E00\u683C\uFF0C\u50CF\u6781\u4E86\u6211\u66FE\u7ECF\u7684\u5DE5\u4F4D\u3002
    \uFF08\u624B\u6307\u4E0B\u610F\u8BC6\u5730\u5728\u65B9\u5411\u76D8\u4E0A\uFF0C\u6572\u51FA\u6253\u5B57\u7684\u8282\u594F\uFF09
    \u51CC\u6668\u4E24\u70B9\uFF0C\u5496\u5561\u65E9\u5C31\u51C9\u4E86\uFF0C\u5589\u5499\u91CC\u53EA\u6709\u82E6\u6DA9\u3002\u5C4F\u5E55\u53F3\u4E0B\u89D2\u7684\u804A\u5929\u6846\u5F39\u51FA\u6765\uFF0C\u8001\u677F\u7684\u5934\u50CF\u5728\u8DF3\uFF1A\u201C\u65B9\u6848\u5F88\u68D2\uFF01\u4F46\u80FD\u4E0D\u80FD\u518D\u4F18\u5316\u4E09\u4E2A\u7248\u672C\uFF1F\u201D
    \u6211\u7684\u624B\u6307\u6BD4\u8111\u5B50\u5FEB\u3002 \u201C\u5F53\u7136\uFF0C\u9A6C\u4E0A\uFF01\u201D
    \u53D1\u9001\u3002 \u9ED1\u8272\u5C4F\u5E55\u7684\u5012\u5F71\u91CC\uFF0C\u6620\u51FA\u6211\u81EA\u5DF1\u7684\u8138\u2014\u2014\u5634\u89D2\u4E0A\u7FD8\u7684\u5F27\u5EA6\uFF0C\u548C\u6628\u5929\u5BF9\u5BA2\u6237\u8BF4\u201C\u5408\u4F5C\u6109\u5FEB\u201D\u65F6\uFF0C\u5206\u6BEB\u4E0D\u5DEE\u3002\u719F\u7EC3\u5F97\u4EE4\u4EBA\u5FC3\u60CA\u3002"
  - "\u5929\u9634\u6C89\u4E0B\u6765\uFF0C\u96E8\u522E\u5668\u81EA\u5DF1\u52A8\u4E86\u4E00\u4E0B\u3002\u9A6C\u4E0A\u5C31\u8981\u5230\u5E7C\u513F\u56ED\u90A3\u6761\u8857\u4E86\u3002
    \u624B\u673A\u4E00\u9707\uFF0C\u662F\u8001\u5E08\u53D1\u6765\u7684\u7167\u7247\uFF1A\u5973\u513F\u5348\u7761\u65F6\uFF0C\u624B\u91CC\u8FD8\u6525\u7740\u4E00\u7247\u997C\u5E72\u3002
    \uFF08\u90A3\u80A1\u719F\u6089\u7684\u3001\u5939\u6742\u7740\u7126\u8651\u548C\u6E29\u67D4\u7684\u60C5\u7EEA\uFF0C\u50CF\u6F6E\u6C34\u4E00\u6837\u6F2B\u4E0A\u6765\uFF09
    \u90A3\u5929\u4E5F\u662F\u8FD9\u6837\uFF0C\u7A81\u7136\u5C31\u4E0B\u96E8\u4E86\u3002\u5979\u5728\u5E7C\u513F\u56ED\u95E8\u53E3\uFF0C\u6307\u7740\u8DEF\u8FB9\u5C0F\u8D29\u624B\u91CC\u7684\u6C14\u7403\uFF0C\u54ED\u5F97\u4E0A\u6C14\u4E0D\u63A5\u4E0B\u6C14\uFF1A\u201C\u6211\u8981\uFF01\u6211\u8981\uFF01\u201D
