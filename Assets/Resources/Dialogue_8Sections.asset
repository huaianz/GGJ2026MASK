  sections:
  - prompt:
      type: 0
      text: "\u8FD9\u4E48\u65E9\u6253\u6270\u4F60\u771F\u4E0D\u597D\u610F\u601D\uFF0C\u4F46\u6211\u597D\u50CF\u4E0D\u5C0F\u5FC3\u628A\u5171\u4EAB\u8FFD\u8E2A\u5668\u5220\u4E86\uFF1F\n\u4F60\u80FD\u6062\u590D\u5417\uFF1F\u8FD8\u662F\u6211\u4EEC\u5B8C\u86CB\u4E86\uFF1F"
    choiceA:
      type: 0
      text: "...\u5C31\u6309\u4E00\u4E0BCtrl Z\u770B\u770B\u80FD\u4E0D\u80FD\u884C"
    branchALines:
    - type: 0
      text: "\u6211\u8BD5\u8FC7\u4E86\uFF01\uFF01\u73B0\u5728\u5C4F\u5E55\u53D8\u6210\u7070\u8272\u4E86\uFF1F"
    - type: 1
      text: "\u51B7\u9759\u70B9..."
    - type: 0
      text: "\u8FD9\u6837\u5F88\u7CDF\u7CD5\u5417\uFF1F"
    - type: 1
      text: "\u522B\u5237\u65B0\u7535\u8111"
    - type: 0
      text: "\u6211\u5E94\u8BE5\u5237\u65B0\u5417\uFF1F"
    - type: 1
      text: "\u4E0D\u8981\uFF01"
    - type: 0
      text: "\u7B49\u7B49\uFF0C\u73B0\u5728\u5B83\u8981\u6062\u590D\u5BC6\u94A5\u3002\u4F60\u6709\u5417\uFF1F"
    - type: 1
      text: "\u6709\uFF0C\u662F83jdcg"
    - type: 0
      text: "\u8C22\u8C22\uFF01\uFF01\uFF01"
    choiceB:
      type: 0
      text: "\u4F60\u53EF\u4EE5\u95EE\u95EEIT\u90E8\u95E8"
    branchBLines:
    - type: 0
      text: "\u4F46IT\u90E8\u95E8\u7684\u4EBA\u597D\u51F6\uFF0C\u4ED6\u4EEC\u80AF\u5B9A\u4F1A\u544A\u8BC9\u6211\u7ECF\u7406\u6211\u641E\u5F97\u4E00\u56E2\u7CDF\u3002"
