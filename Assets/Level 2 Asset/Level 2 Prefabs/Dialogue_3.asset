  sections:
  - prompt:
      type: 0
      text: "\"\u6700\u7EC8\u7248_v3\"\u7684logo\u6211\u4EEC\u5B58\u54EA\u513F\u4E86\uFF1F\u6211\u53EA\u770B\u5230\"\u6700\u7EC8\u7248_v2_\u5C31\u7528\u8FD9\u4E2A\"\uFF0C\u800C\u4E14\u770B\u8D77\u6765\u6709\u70B9\u6A21\u7CCA\u3002"
    choiceA:
      type: 0
      text: "\u67E5\u4E00\u4E0B\"\u5B58\u6863\"\u6587\u4EF6\u5939\uFF1F"
    branchALines:
    - type: 0
      text: "\u54EA\u4E2A\uFF1F\u5E26\u65E5\u671F\u7684\u90A3\u4E2A\uFF1F\u8FD8\u662F\u90A3\u4E2A\u53EB\"\u522B\u78B0\"\u7684\uFF1F\r\n\u53E6\u5916\uFF0C\u5BA2\u6237\u8981PNG\u683C\u5F0F\u4F46\u8981\u900F\u660E\u80CC\u666F\u3002\u4F60\u6709Photoshop\u6E90\u6587\u4EF6\u5417\uFF1F\r"
    - type: 1
      text: "\u55EF...\u5E2601_\u7684\u90A3\u4E2A\n\u6211\u73B0\u5728\u771F\u7684\u6CA1\u6CD5\u53D1PS\u6587\u4EF6\uFF0C\u4E5F\u8BB8\u665A\u70B9\uFF1F\r"
    - type: 0
      text: "\u6211\u60F3\u8FD9\u5C31\u662F\"\u665A\u70B9\"\u4E86^^\r"
    - type: 1
      text: "\u7B49\u7B49\uFF0C\u4F60\u8FD9\u8BDD\u5230\u5E95\u4EC0\u4E48\u610F\u601D\uFF1F\uFF01\r"
    - type: 0
      text: "\u4F46\u6211\u771F\u7684\u5F88\u6025\uFF0C\u53D1\u4E2A\u6587\u4EF6\u771F\u7684\u5C315\u5206\u949F\uFF0C\u6C42\u6C42\u4E86\r"
    - type: 0
      text: "\u6211\u4E00\u4E0A\u5730\u94C1\u5C31\u53D1\n\r"
    choiceB:
      type: 0
      text: "[\u5C31\u7528\u8FD9\u4E2A.png]"
    branchBLines: []
